rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled != false;
    }

    // Admin role documents are provisioned manually by the project owner in
    // Firebase Console. A signed-in user may read only their own role record.
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    match /players/{playerId} {
      allow read: if true;
      allow create: if request.resource.data.score == 0
                    && request.resource.data.currentPhase == 1
                    && request.resource.data.agentName is string;
      allow update: if isAdmin() || (
          request.resource.data.agentName == resource.data.agentName
          && request.resource.data.score >= resource.data.score
          && request.resource.data.score <= 900
          && request.resource.data.currentPhase >= resource.data.currentPhase
        );
      allow delete: if isAdmin();
    }
  }
}
